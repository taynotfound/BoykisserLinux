#!/bin/sh
# boykisser-wallpaper :3   -   give every XFCE monitor a Boykisser wallpaper.
#
#   boykisser-wallpaper           fill in monitors that have no wallpaper yet
#   boykisser-wallpaper --force   put the theme's wallpaper on every monitor
#   boykisser-wallpaper --next    cycle to the next Boykisser wallpaper
#
# XFCE stores a backdrop per connector (eDP-1, HDMI-A-1, Virtual-1, ...), so a
# shipped xfce4-desktop.xml never matches real outputs and new monitors come up
# grey. This runs at login and only fills the gaps, so a wallpaper the user
# picked themselves is never overwritten.

DIR=/usr/share/backgrounds/boykisser
CHAN=xfce4-desktop
MODE="$(cat "${HOME}/.config/boykisser/mode" 2>/dev/null || echo dark)"
[ "$MODE" = light ] && WALL="$DIR/daydream.jpg" || WALL="$DIR/nightfall.jpg"
[ -f "$WALL" ] || WALL="$(ls "$DIR"/* 2>/dev/null | head -n1)"
[ -n "$WALL" ] || exit 0

ACTION="${1:-fill}"

set_prop() { # type path value
	xfconf-query -c "$CHAN" -p "$2" -s "$3" 2>/dev/null \
		|| xfconf-query -c "$CHAN" -p "$2" -n -t "$1" -s "$3" 2>/dev/null
}

stamp() { # backdrop-base image
	set_prop string "$1/last-image" "$2"
	set_prop int    "$1/image-style" 5   # zoomed
	set_prop int    "$1/color-style" 0
}

outputs() {
	command -v xrandr >/dev/null 2>&1 && xrandr 2>/dev/null | awk '/ connected/{print $1}'
}

if [ "$ACTION" = "--next" ]; then
	CUR="$(xfconf-query -c "$CHAN" -l 2>/dev/null | grep 'last-image$' | head -n1 | xargs -r xfconf-query -c "$CHAN" -p 2>/dev/null)"
	# the file after the current one, wrapping around to the first
	WALL="$(ls "$DIR"/* | awk -v cur="$CUR" 'NR==1{first=$0} found&&!done{print; done=1} $0==cur{found=1} END{if(!done)print first}')"
	ACTION=--force
fi

# xfdesktop/xfconfd can start a few seconds after autostart in the live
# session; wait for the channel instead of racing it.
n=0
until xfconf-query -c "$CHAN" -l >/dev/null 2>&1 || [ "$n" -ge 30 ]; do
	n=$((n + 1)); sleep 1
done

set_prop bool /backdrop/single-workspace-mode true

for mon in $(outputs) 0; do
	case "$mon" in 0) base=/backdrop/screen0/monitor0/workspace0 ;; *) base="/backdrop/screen0/monitor$mon/workspace0" ;; esac
	cur="$(xfconf-query -c "$CHAN" -p "$base/last-image" 2>/dev/null)"
	if [ "$ACTION" = "--force" ] || [ -z "$cur" ] || [ ! -f "$cur" ]; then
		stamp "$base" "$WALL"
	fi
done

xfdesktop --reload >/dev/null 2>&1 || true
