#!/bin/sh
# Boykisser Linux  -  install the proprietary NVIDIA driver after install. :3
# Done on the installed system so DKMS builds against the right kernel headers.
#
#   boykisser-nvidia        interactive
#   boykisser-nvidia -y     don't ask
set -e

YELLOW='\033[1;33m'; PINK='\033[1;35m'; RESET='\033[0m'
say()  { printf "${PINK}%s${RESET}\n" "$1"; }
warn() { printf "${YELLOW}%s${RESET}\n" "$1"; }

printf "${PINK}=== Boykisser Linux  -  NVIDIA driver setup :3 ===${RESET}\n\n"

if [ "$(id -u)" -ne 0 ]; then
	echo "Need root  -  re-running with sudo..."
	exec sudo "$0" "$@"
fi

# Refuse to run from the live session (no persistent kernel/headers there).
if [ -d /run/live ] || grep -qw "boot=live" /proc/cmdline 2>/dev/null; then
	warn "You're in the live session."
	echo "Install Boykisser Linux to disk first, then run this. :3"
	exit 1
fi

if ! lspci 2>/dev/null | grep -iE 'vga|3d|display' | grep -qi nvidia; then
	warn "No NVIDIA GPU found  -  nothing to do."
	exit 0
fi

if lsmod | grep -q '^nvidia ' && dpkg -s nvidia-driver >/dev/null 2>&1; then
	say "The NVIDIA driver is already installed and loaded. :3"
	exit 0
fi

echo "Detecting your GPU..."
command -v nvidia-detect >/dev/null 2>&1 && { nvidia-detect || true; echo ""; }

SECUREBOOT=0
if command -v mokutil >/dev/null 2>&1 && mokutil --sb-state 2>/dev/null | grep -qi 'SecureBoot enabled'; then
	SECUREBOOT=1
	warn "Secure Boot is ON. The driver module has to be signed with a key your firmware trusts."
	echo "After the install you'll set a one-time password, and on the next boot a blue"
	echo "'MOK management' screen asks for it: choose 'Enroll MOK' -> 'Continue' -> 'Yes'."
	echo ""
fi

printf "This will install: ${PINK}nvidia-driver${RESET} (+ DKMS, headers, 32-bit libs for Steam).\n"
if [ "${1:-}" != "-y" ]; then
	printf "Proceed? [y/N] "
	read -r ans
	case "$ans" in
		y|Y|yes|YES) ;;
		*) echo "Aborted. :3"; exit 0 ;;
	esac
fi

export DEBIAN_FRONTEND=noninteractive

# Make sure contrib/non-free are enabled (Boykisser ships them, but be safe).
if ! grep -rqsE 'non-free' /etc/apt/sources.list /etc/apt/sources.list.d/; then
	sed -i 's/ main$/ main contrib non-free non-free-firmware/' /etc/apt/sources.list || true
fi

dpkg --add-architecture i386
apt-get update

# Headers for the *running* kernel (backports kernels need their own headers).
apt-get install -y "linux-headers-$(uname -r)" 2>/dev/null || apt-get install -y linux-headers-amd64

if ! apt-get install -y nvidia-driver nvidia-settings firmware-misc-nonfree; then
	warn "Driver install failed. Check the 'nvidia-detect' output above:"
	echo "older GPUs may need a legacy driver (e.g. nvidia-tesla-470-driver)."
	exit 1
fi
# 32-bit userspace for Steam / Proton.
apt-get install -y nvidia-driver-libs:i386 || true

if [ "$SECUREBOOT" = 1 ]; then
	KEY=/var/lib/dkms/mok.pub
	if [ -f "$KEY" ]; then
		if mokutil --test-key "$KEY" 2>/dev/null | grep -qi 'already enrolled'; then
			say "Signing key already enrolled."
		else
			say "Choose a one-time password (you'll type it once on the next boot):"
			mokutil --import "$KEY"
		fi
	else
		warn "No DKMS signing key at $KEY  -  the module may not load with Secure Boot on."
	fi
fi

say ""
say "NVIDIA driver installed! Reboot to load it. :3"
