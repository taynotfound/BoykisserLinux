---
import { Image } from 'astro:assets';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/nunito';
import '@fontsource-variable/jetbrains-mono';
import '../styles/landing.css';

import mascot from '../assets/mascot.png';
import Logo from '../assets/brand/logo.svg';
import shotXfce from '../assets/screenshots/xfce.png';
import shotCenter from '../assets/screenshots/boykisser-center.png';
import shotKde from '../assets/screenshots/kde.png';
import shotInstaller from '../assets/screenshots/installer.png';
import shotGrub from '../assets/screenshots/grub.png';

const GITHUB = 'https://github.com/taynotfound/BoykisserLinux';
const RELEASES = `${GITHUB}/releases/latest`;
const DISCORD = 'https://discord.gg/3ZpwE9PPfP';

const title = 'Boykisser Linux :3';
const description =
	'A pink Debian 13 spin with XFCE or KDE Plasma. Flatpak, Steam and OBS are set up out of the box, and there is no telemetry.';

const features = [
	{
		icon: 'fa-palette',
		title: 'Pink everywhere',
		text: "The boot menu, splash screen, installer, login screen, desktop and icons all match. There's a light and a dark version and you can switch with one click.",
	},
	{
		icon: 'fa-desktop',
		title: 'XFCE or KDE Plasma',
		text: 'XFCE is the default and installs offline. If you pick Plasma in the installer it gets downloaded and themed the same way.',
	},
	{
		icon: 'fa-gamepad-modern',
		title: 'Gaming',
		text: 'Steam (with the 32-bit libraries it needs), Heroic, GameMode and MangoHud come with the full ISO.',
	},
	{
		icon: 'fa-video',
		title: 'Streaming',
		text: 'OBS Studio is installed with the virtual camera set up, so Discord and your browser can use it right away.',
	},
	{
		icon: 'fa-box-open',
		title: 'Flatpak',
		text: 'Flathub is set up from the start. GNOME Software is the app store, with Flatseal and Gear Lever next to it.',
	},
	{
		icon: 'fa-sliders',
		title: 'Boykisser Center',
		text: 'One window for updates, app packs, NVIDIA drivers, newer kernels, a system check and bug reports.',
	},
	{
		icon: 'fa-shield-check',
		title: 'Private and up to date',
		text: 'No telemetry and no accounts. The firewall is on, security updates install by themselves, and Timeshift can snapshot before every update.',
	},
	{
		icon: 'fa-laptop',
		title: 'Old hardware',
		text: "There's a Lite ISO for older BIOS-only machines that won't boot the normal one.",
	},
];
const flavours = [
	{
		id: 'full',
		name: 'Full',
		badge: 'Recommended',
		size: '~2.6 GB',
		text: 'Steam, OBS, VS Code and codecs are already in the image. Installs without internet.',
	},
	{
		id: 'netinstall',
		name: 'Netinstall',
		size: '~1.5 GB',
		text: 'Same desktop, smaller download. The bigger apps download on the first boot, so you need internet for that.',
	},
	{
		id: 'lite',
		name: 'Lite',
		size: '~1.8 GB',
		text: 'For older machines with BIOS-only firmware. Leaves out the heavy apps and starts in safe graphics mode.',
	},
];

const shots = [
	{ id: 'xfce', label: 'XFCE', img: shotXfce, alt: 'The Boykisser XFCE desktop with the pink panel, desktop icons and a system widget' },
	{ id: 'kde', label: 'KDE Plasma', img: shotKde, alt: 'The Boykisser KDE Plasma desktop with a dark panel and the Boykisser start button' },
	{ id: 'center', label: 'Boykisser Center', img: shotCenter, alt: 'Boykisser Center, a grid of tiles for updates, apps, drivers and more' },
	{ id: 'installer', label: 'Installer', img: shotInstaller, alt: 'The Boykisser installer with optional app bundles for gaming, streaming, development and office' },
	{ id: 'grub', label: 'Boot menu', img: shotGrub, alt: 'The pink Boykisser boot menu on an installed system' },
];

const wallpapers = ['boykisser1', 'boykisser2', 'boykisser3', 'boykisser4', 'boykisser5', 'boykisser6'];
const wallExt: Record<string, string> = {
	boykisser1: 'png', boykisser2: 'png', boykisser3: 'jpg', boykisser4: 'png', boykisser5: 'jpeg', boykisser6: 'jpeg',
};
const RAW = 'https://raw.githubusercontent.com/taynotfound/BoykisserLinux/main/config/includes.chroot/usr/share/backgrounds/boykisser';

const cli = [
	['center', 'open the Boykisser Center'],
	['update', 'apt, Flatpak, firmware and these tools'],
	['doctor', 'check the health of your system'],
	['presets', 'Art, Social, Office and Music app packs'],
	['browser', 'Firefox, LibreWolf, Brave or Chromium'],
	['theme', 'switch look: light | dark'],
	['nvidia', 'install the proprietary NVIDIA driver'],
	['report', 'open a pre-filled bug report'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href="https://boykisser.taymaerz.de/" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#160e24" />
		<meta property="og:site_name" content="Boykisser Linux" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://boykisser.taymaerz.de/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://boykisser.taymaerz.de/og.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://kit-pro.fontawesome.com" crossorigin />
		<link rel="stylesheet" href="https://kit-pro.fontawesome.com/releases/v7.0.0/css/pro.min.css" media="print" onload="this.media='all'" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'SoftwareApplication',
			name: 'Boykisser Linux',
			operatingSystem: 'Linux',
			applicationCategory: 'OperatingSystem',
			description,
			url: 'https://boykisser.taymaerz.de/',
			image: 'https://boykisser.taymaerz.de/og.png',
			downloadUrl: RELEASES,
			author: { '@type': 'Person', name: 'Tay Maerz', url: 'https://taymaerz.de' },
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		})} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>

		<header class="nav">
			<a class="brand" href="/">
				<Logo width={34} height={34} aria-hidden="true" />
				<span>Boykisser Linux</span>
			</a>
			<nav aria-label="Main">
				<a href="#features">Features</a>
				<a href="#look">Screenshots</a>
				<a href="/docs/getting-started/">Docs</a>
				<a href={GITHUB}><i class="fa-brands fa-github" aria-hidden="true"></i> GitHub</a>
				<a class="btn btn-sm btn-primary" href="#download"><i class="fa-solid fa-download" aria-hidden="true"></i> Download</a>
			</nav>
		</header>

		<main id="main">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Debian 13 (trixie) · XFCE or KDE Plasma · amd64</p>
					<h1>Boykisser<br /><span class="pink">Linux :3</span></h1>
					<p class="lede">
						A pink Debian spin I actually daily drive. It's normal Debian 13 underneath,
						with Steam, OBS and Flatpak already set up when you first log in.
					</p>
					<div class="cta">
						<a class="btn btn-primary" href="#download"><i class="fa-solid fa-download" aria-hidden="true"></i> Download</a>
						<a class="btn" href="/docs/getting-started/"><i class="fa-solid fa-book" aria-hidden="true"></i> Docs</a>
						<a class="btn" href={DISCORD}><i class="fa-brands fa-discord" aria-hidden="true"></i> Discord</a>
					</div>
					<p class="release" data-release hidden></p>
				</div>
				<div class="hero-art">
					<div class="window">
						<div class="window-bar" aria-hidden="true"><span></span><span></span><span></span></div>
						<Image src={shotXfce} alt="The Boykisser Linux XFCE desktop" widths={[640, 960, 1280]} sizes="(max-width: 900px) 92vw, 560px" loading="eager" />
					</div>
					<Image class="hero-cat" src={mascot} alt="" width={180} height={180} data-cat />
				</div>
			</section>

			<ul class="pills" aria-label="At a glance">
				<li><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> No telemetry</li>
				<li><i class="fa-solid fa-microchip" aria-hidden="true"></i> UEFI and legacy BIOS</li>
				<li><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Firewall on</li>
				<li><i class="fa-solid fa-rotate" aria-hidden="true"></i> Automatic security updates</li>
			</ul>

			<section id="features" class="section">
				<h2>What's included</h2>
				<p class="section-lede">I set these up so I don't have to every time I reinstall. Now you don't either.</p>
				<div class="features">
					{features.map((f) => (
						<article class="card">
							<span class="card-icon" aria-hidden="true"><i class={`fa-solid ${f.icon}`}></i></span>
							<h3>{f.title}</h3>
							<p>{f.text}</p>
						</article>
					))}
				</div>
			</section>

			<section id="look" class="section">
				<h2>Screenshots</h2>
				<div class="tabs" role="tablist" aria-label="Screenshots">
					{shots.map((s, i) => (
						<button role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
							{s.label}
						</button>
					))}
				</div>
				{shots.map((s, i) => (
					<div class="shot" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
						<Image src={s.img} alt={s.alt} widths={[640, 960, 1280]} sizes="(max-width: 1100px) 92vw, 1000px" />
					</div>
				))}
			</section>

			<section class="section split">
				<div>
					<h2>The <code>boykisser</code> command</h2>
					<p>
						All the Boykisser tools are subcommands of <code>boykisser</code>, and most of them are
						also buttons in the Boykisser Center. They're small shell scripts, shipped as Debian
						packages, and <code>boykisser update</code> keeps them current.
					</p>
					<a class="link" href="/docs/cli/">All commands <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
				</div>
				<div class="terminal" aria-label="Output of the boykisser command">
					<div class="window-bar" aria-hidden="true"><span></span><span></span><span></span></div>
					<pre><code><span class="prompt">user@boykisser:~$</span> boykisser
<span class="pink"><b>Boykisser Linux :3</b></span>

<b>usage:</b> boykisser &lt;command&gt;
{cli.map(([cmd, desc]) => <Fragment>{'\n  '}<span class="pink">{cmd.padEnd(10)}</span> {desc}</Fragment>)}
  <span class="dim">...</span></code></pre>
				</div>
			</section>

			<section class="section">
				<h2>Wallpapers</h2>
				<p class="section-lede">All six come with the ISO. <code>boykisser wallpaper --next</code> switches to the next one.</p>
				<div class="walls">
					{wallpapers.map((w, i) => (
						<a href={`${RAW}/${w}.${wallExt[w]}`} target="_blank" rel="noopener">
							<img src={`/wallpapers/${w}.webp`} alt={`Boykisser wallpaper ${i + 1}`} width="640" height="360" loading="lazy" />
						</a>
					))}
				</div>
			</section>

			<section id="download" class="section">
				<h2>Get Boykisser Linux</h2>
				<p class="section-lede">
					There are three versions, rebuilt every Monday with the latest Debian updates.
					If you're not sure, get <b>Full</b>.
				</p>
				<div class="flavours">
					{flavours.map((f) => (
						<article class={`card flavour ${f.badge ? 'featured' : ''}`} data-flavour={f.id}>
							{f.badge && <span class="badge">{f.badge}</span>}
							<h3>{f.name}</h3>
							<p class="size" data-size>{f.size}</p>
							<p>{f.text}</p>
							<div class="flavour-links">
								<a class="btn btn-primary btn-sm" data-direct href={RELEASES}><i class="fa-solid fa-download" aria-hidden="true"></i> Download</a>
								<a class="btn btn-sm" data-torrent href={RELEASES} hidden><i class="fa-solid fa-magnet" aria-hidden="true"></i> Torrent</a>
							</div>
						</article>
					))}
				</div>

				<ol class="steps">
					<li>
						<h3>Verify</h3>
						<p>Verify the download against <code>SHA256SUMS</code> from the release.</p>
					</li>
					<li>
						<h3>Flash</h3>
						<p>Write the ISO to a USB stick with <a href="https://etcher.balena.io/">Etcher</a>, <a href="https://rufus.ie/">Rufus</a> or <code>dd</code>.</p>
					</li>
					<li>
						<h3>Boot</h3>
						<p>Try the live session, then double-click <b>Install Boykisser Linux</b> on the desktop.</p>
					</li>
				</ol>
				<p class="fineprint">
					Needs a 64-bit PC with 2 GB RAM (4 GB+ recommended) and 20 GB of disk.
					<a href="/docs/downloading/">Download guide <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
				</p>
			</section>

			<section class="section faq">
				<h2>FAQ</h2>
				<details>
					<summary>Is this a joke distro?</summary>
					<p>The name is a meme, but I use it every day. It's Debian 13 with a lot of setup done for you, so anything that works on Debian works here too.</p>
				</details>
				<details>
					<summary>Does it phone home?</summary>
					<p>No. There's no telemetry and no account. The only thing Boykisser itself connects to is GitHub, to check for tool updates when you run <code>boykisser update</code>.</p>
				</details>
				<details>
					<summary>Can I use it for gaming?</summary>
					<p>Yes. Steam, Proton, Heroic, GameMode and MangoHud are ready on the full ISO, and <code>boykisser nvidia</code> installs the proprietary driver if you have an NVIDIA card.</p>
				</details>
				<details>
					<summary>Who makes this?</summary>
					<p>Me, <a href="https://taymaerz.de">Tay</a>. It's a hobby project. If something breaks, run <code>boykisser report</code> or tell me on <a href={DISCORD}>Discord</a>.</p>
				</details>
				<a class="link" href="/docs/faq/">More in the docs <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-inner">
				<div class="brand">
					<Logo width={30} height={30} aria-hidden="true" />
					<span>Boykisser Linux</span>
				</div>
				<nav aria-label="Footer">
					<a href="/docs/getting-started/">Docs</a>
					<a href={GITHUB}><i class="fa-brands fa-github" aria-hidden="true"></i> GitHub</a>
					<a href={DISCORD}><i class="fa-brands fa-discord" aria-hidden="true"></i> Discord</a>
					<a href="https://ko-fi.com/taygotkofi"><i class="fa-solid fa-mug-hot" aria-hidden="true"></i> Ko-fi</a>
					<a href="https://github.com/sponsors/taynotfound"><i class="fa-solid fa-heart" aria-hidden="true"></i> Sponsor</a>
				</nav>
			</div>
			<p class="fineprint">
				Made by <a href="https://taymaerz.de">Tay Maerz</a>. Boykisser is a community meme character and this is unofficial fan work.
				Not affiliated with Debian. Debian is a trademark of Software in the Public Interest, Inc.
			</p>
		</footer>

		<script>
			import { initLanding } from '../scripts/landing';
			initLanding();
		</script>
	</body>
</html>
