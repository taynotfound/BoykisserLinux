#!/bin/sh
# boykisser-report :3  —  report a bug/error on GitHub Issues.
#
# Gathers optional, non-personal system info, pre-fills a GitHub issue with it,
# and opens the browser. Nothing is ever sent anywhere automatically.
#
# Usage:
#   boykisser-report                       open a pre-filled GitHub issue
#   boykisser-report --no-sysinfo          without the system info block

REPO_URL="https://github.com/taynotfound/BoykisserLinux/issues/new"

PINK="\033[38;5;213m"; B="\033[1m"; R="\033[0m"
say() { printf "${PINK}%s${R}\n" "$1"; }

SYSINFO=1
[ "${1:-}" = "--no-sysinfo" ] && SYSINFO=0

# --- optional system info (nothing personally identifying) ---------------------
BODY="## What happened?

(describe the problem here)

## Steps to reproduce

1.
"
if [ "$SYSINFO" = 1 ]; then
	VER=$(head -n1 /etc/boykisser/version 2>/dev/null || echo "unknown")
	VARIANT=$(cat /etc/boykisser/variant 2>/dev/null || echo "unknown")
	KERNEL=$(uname -r)
	DE="${XDG_CURRENT_DESKTOP:-unknown}"
	MEM=$(awk '/MemTotal/{printf "%.1f GiB", $2/1048576}' /proc/meminfo 2>/dev/null)
	GPU=$(lspci 2>/dev/null | grep -iE 'vga|3d' | head -1 | sed 's/^[^:]*: //')
	FAILED=$(systemctl --failed --no-legend 2>/dev/null | awk '{print $1}' | tr '\n' ' ')
	BODY="$BODY
## System info

| | |
|---|---|
| Version | $VER |
| Variant | $VARIANT |
| Kernel | $KERNEL |
| Desktop | $DE |
| RAM | ${MEM:-?} |
| GPU | ${GPU:-?} |
| Failed units | ${FAILED:-none} |
"
fi

# --- URL-encode the body and open the browser -----------------------------------
enc() {
	printf '%s' "$1" | od -An -tx1 -v | tr ' ' '\n' | grep -v '^$' | while read -r h; do
		case "$h" in
			2d|2e|5f|7e|3[0-9]|4[1-9a-f]|5[0-9a]|6[1-9a-f]|7[0-9a]) printf '%b' "\\x$h" ;;
			*) printf '%%%s' "$h" ;;
		esac
	done
}
URL="$REPO_URL?title=$(enc "[bug] ")&body=$(enc "$BODY")"

say ":3 opening a GitHub issue for you..."
if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null 2>&1; then
	xdg-open "$URL" >/dev/null 2>&1 &
	say "   fill in what happened and hit Submit — thank you! mwah"
else
	say "   no browser session found. Please open this page to report:"
	printf '%s\n' "$REPO_URL"
	[ "$SYSINFO" = 1 ] && { say "   and paste this system info:"; printf '%s\n' "$BODY"; }
fi
