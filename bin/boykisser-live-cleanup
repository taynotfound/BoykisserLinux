#!/bin/sh
# Boykisser Linux — remove live-system packages from the installed target :3
#
# Called by the Calamares contextualprocess module (both the XFCE and KDE
# branches) with the mounted target root (@@ROOT@@). This replaces the stock
# Calamares `packages` module cleanup: that module's apt backend runs
# `apt-get remove` AND `apt-get --purge -y autoremove` for every package, and
# on the freshly-copied offline target one of those apt calls can abort the
# whole install with "Package Manager error ... returned error code 110".
#
# We use dpkg directly (no network, no resolver) and NEVER return non-zero,
# so a hiccup here can't fail an otherwise perfect installation.

ROOT="${1:-/}"

log() { echo "boykisser-live-cleanup: $*"; }

if [ ! -d "$ROOT/var/lib/dpkg" ]; then
	log "no dpkg database under '$ROOT' — nothing to do."
	exit 0
fi

# Live-only packages that must not linger on the installed system.
LIVE_PKGS="
live-boot
live-boot-doc
live-config
live-config-doc
live-config-systemd
live-tools
live-task-localisation
live-task-recommended
calamares-settings-debian
"

for pkg in $LIVE_PKGS; do
	# Only touch packages dpkg actually knows about.
	if chroot "$ROOT" dpkg-query -W -f '${Status}' "$pkg" 2>/dev/null | grep -q "installed"; then
		log "purging $pkg"
		chroot "$ROOT" env DEBIAN_FRONTEND=noninteractive \
			dpkg --purge --force-depends "$pkg" >/dev/null 2>&1 \
			|| log "could not purge $pkg (ignored)"
	fi
done

# Best-effort tidy-up; apt may be unusable offline at this point — that's fine.
chroot "$ROOT" env DEBIAN_FRONTEND=noninteractive \
	apt-get -y --purge autoremove >/dev/null 2>&1 \
	|| log "autoremove skipped (ignored)"

# Re-enable automatic security updates on the installed system (masked in the
# live image to save live-session bandwidth).
for unit in apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service; do
	chroot "$ROOT" systemctl unmask "$unit" >/dev/null 2>&1 || true
done
log "automatic security updates enabled on installed system"

log "done :3"
exit 0
