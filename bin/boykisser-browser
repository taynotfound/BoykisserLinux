#!/bin/sh
# boykisser-browser :3  —  pick your browser.
# Firefox ESR ships with the ISO; this installs an alternative (and optionally
# removes Firefox). LibreWolf and Brave come from Flathub, Chromium from apt.
# Usage: boykisser-browser [firefox|librewolf|brave|chromium]

FLATHUB="https://dl.flathub.org/repo/flathub.flatpakrepo"

flat_install() {
	command -v flatpak >/dev/null 2>&1 || { echo "!! flatpak missing" >&2; return 1; }
	flatpak remote-add --if-not-exists flathub "$FLATHUB" 2>/dev/null \
		|| sudo flatpak remote-add --if-not-exists flathub "$FLATHUB" || true
	flatpak install -y --noninteractive flathub "$1"
}

install_browser() {
	case "$1" in
		firefox)
			sudo apt-get install -y firefox-esr ;;
		librewolf)
			flat_install io.gitlab.librewolf-community ;;
		brave)
			flat_install com.brave.Browser ;;
		chromium)
			sudo apt-get update && sudo apt-get install -y chromium ;;
		*)
			echo "unknown browser: $1 (firefox|librewolf|brave|chromium)" >&2; return 1 ;;
	esac || return 1
	echo ":3 $1 installed!"
	if [ "$1" != firefox ] && command -v firefox-esr >/dev/null 2>&1; then
		printf "Remove Firefox ESR? [y/N] "
		read -r yn
		case "$yn" in
			[Yy]*) sudo apt-get purge -y firefox-esr && sudo apt-get autoremove -y ;;
		esac
	fi
}

if [ $# -gt 0 ]; then
	install_browser "$1"
	exit $?
fi

if command -v yad >/dev/null 2>&1 && [ -n "$DISPLAY$WAYLAND_DISPLAY" ]; then
	choice=$(yad --list --title="Pick a browser :3" \
		--width=480 --height=280 --center --borders=12 \
		--text="<b>Which browser do you want?</b>\nFirefox ESR is already installed." \
		--column="Browser" --column=id --hide-column=2 --no-headers \
		"Firefox ESR  (already installed, from Debian)" firefox \
		"LibreWolf  (privacy-focused Firefox, Flathub)" librewolf \
		"Brave  (Chromium with adblock, Flathub)" brave \
		"Chromium  (plain, from Debian)" chromium \
		--button="Install:0" --button="Cancel:1" 2>/dev/null) || exit 0
	sel=$(printf '%s' "$choice" | awk -F'|' '{print $2}')
	[ -n "$sel" ] || exit 0
	x-terminal-emulator -e sh -c "boykisser-browser $sel; echo; read -p 'Press enter to close...' _" 2>/dev/null \
		|| install_browser "$sel"
	exit 0
fi

echo "Pick a browser :3  — firefox | librewolf | brave | chromium"
printf "browser> "
read -r sel
[ -n "$sel" ] && install_browser "$sel"
