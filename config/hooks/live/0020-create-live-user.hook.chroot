#!/bin/sh
set -e

# Create the live user account that live-config expects but can't create
# without user-setup package installed.
for g in sudo audio video plugdev netdev cdrom floppy dialout autologin; do
	groupadd -f "$g"
done
useradd -m -s /bin/bash -G sudo,audio,video,plugdev,netdev,cdrom,floppy,dialout,autologin user
echo "user:live" | chpasswd
