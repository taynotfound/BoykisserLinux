#!/bin/sh
set -e

# Create the live user account that live-config expects but can't create
# without user-setup package installed.
useradd -m -s /bin/bash -G sudo,audio,video,plugdev,netdev,cdrom,floppy,dialout user
echo "user:live" | chpasswd

# autologin group is what live-config/LightDM uses
groupadd -f autologin
usermod -aG autologin user
