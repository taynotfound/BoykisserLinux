#!/bin/sh
# Bake the live user password into the image so LightDM accepts "live" at the
# greeter. live-config sets it from the boot param too, but this ensures it's
# already correct before any display manager reads the shadow file.
useradd -m -s /bin/bash boykisser 2>/dev/null || true
echo "boykisser:live" | chpasswd
usermod -aG sudo,audio,cdrom,dip,floppy,video,plugdev,netdev,powerdev,scanner,bluetooth,autologin boykisser 2>/dev/null || true
