#!/bin/sh
# Enable the services Boykisser Linux needs, and set the graphical target.
set -e

echo "Enabling services :3"

systemctl set-default graphical.target || true

# Display manager + core daemons
systemctl enable lightdm.service        || true
systemctl enable NetworkManager.service || true
systemctl enable bluetooth.service      || true

# First-boot helper that installs the Flatpak apps (Heroic, Discord, ...)
systemctl enable boykisser-firstboot.service || true

# Compressed RAM swap (config in /etc/default/zramswap)
systemctl enable zramswap.service || true

# Printing + laptop power profiles + firewall (packages may be absent on the
# netinstall squashfs — enabling a missing unit is harmless with || true)
systemctl enable cups.service || true
systemctl enable power-profiles-daemon.service || true
systemctl enable ufw.service || true

# No background apt work in the LIVE session (wasted bandwidth on read-only
# media). boykisser-live-cleanup unmasks these on the installed system, where
# unattended-upgrades then delivers automatic security updates.
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service || true

# Make sure NetworkManager (not ifupdown) manages networking in the live/installed system
mkdir -p /etc/NetworkManager/conf.d
cat > /etc/NetworkManager/conf.d/10-globally-managed-devices.conf <<'EOF'
[keyfile]
unmanaged-devices=none
EOF
