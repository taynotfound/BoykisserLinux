#!/bin/sh
# Boykisser Linux goodies :3
# Drops the /etc/boykisser metadata and wires up friendly shell aliases.
set -e

echo "Sprinkling Boykisser goodies :3"

# --- /etc/boykisser metadata --------------------------------------------------
mkdir -p /etc/boykisser

# build.sh / CI drop the variant marker (netinstall | lite) and the release tag
# into includes.chroot, so they are already here. Record which flavour this is.
if [ -e /etc/boykisser/lite ]; then
	VARIANT="lite"
elif [ -e /etc/boykisser/netinstall ]; then
	VARIANT="netinstall"
else
	VARIANT="full"
fi
echo "$VARIANT" > /etc/boykisser/variant

RELEASE="$(cat /etc/boykisser/release 2>/dev/null || echo dev)"
DEBVER="$(cat /etc/debian_version 2>/dev/null || echo 13)"
cat > /etc/boykisser/version <<EOF
Boykisser Linux $RELEASE :3  (Debian $DEBVER · trixie · amd64 · $VARIANT)
built $(date -u +%Y-%m-%d)
https://boykisser.taymaerz.de
EOF

# Let tools like fastfetch and hostnamectl show the release too.
sed -i '/^IMAGE_VERSION=/d;/^VARIANT_ID=/d' /etc/os-release
printf 'IMAGE_VERSION="%s"\nVARIANT_ID=%s\n' "$RELEASE" "$VARIANT" >> /etc/os-release

# base-files owns /usr/lib/os-release (and ships /etc/os-release as a symlink to
# it), so every Debian point release would put the Debian branding back. Divert
# the real file so base-files writes /usr/lib/os-release.debian instead, and keep
# /etc/os-release pointing at ours. (live-build holds its own diversion on
# /etc/os-release during the build and drops it afterwards without renaming, so
# leave that path's diversion alone.)
cp /etc/os-release /tmp/os-release.boykisser
dpkg-divert --quiet --local --no-rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release
mv -f /tmp/os-release.boykisser /usr/lib/os-release
ln -sf ../usr/lib/os-release /etc/os-release

# --- friendly shell aliases + a tip -------------------------------------------
if [ -f /etc/bash.bashrc ] && ! grep -q 'BOYKISSER_ALIASES' /etc/bash.bashrc; then
	cat >> /etc/bash.bashrc <<'EOF'

# Boykisser Linux aliases :3
if [ -n "$PS1" ] && [ -z "$BOYKISSER_ALIASES" ]; then
	export BOYKISSER_ALIASES=1
	alias update='boykisser-update'
	alias cleanup='boykisser-cleanup'
	alias doctor='boykisser-doctor'
	alias bk='boykisser'
	alias ll='ls -lah --color=auto'
	alias la='ls -A --color=auto'
fi
EOF
fi
