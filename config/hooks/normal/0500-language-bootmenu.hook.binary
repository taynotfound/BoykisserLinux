#!/bin/sh
# Boykisser Linux — add a language submenu to the boot menus :3
# Runs after live-build generated the binary payload; appends localized live
# entries (locale + keyboard) to both GRUB (UEFI) and isolinux (BIOS).
# live-config generates the chosen locale at boot (locales= / keyboard-layouts=).
set -e

echo "Adding language boot entries :3"

# live-build runs binary hooks from inside binary/; accept the build root too.
if [ -d binary/live ]; then B=binary; ROOT=.; else B=.; ROOT=..; fi

# kernel/initrd paths as seen from the ISO root
KERNEL="$(cd "$B" && ls live/vmlinuz-* 2>/dev/null | head -n1)"
INITRD="$(cd "$B" && ls live/initrd.img-* 2>/dev/null | head -n1)"
KERNEL="/$KERNEL"; INITRD="/$INITRD"
[ "$KERNEL" != "/" ] || { echo "  (no kernel found — skipping)"; exit 0; }

# Must match the default entry from auto/config. username= has to name the
# account hooks/live/0020 creates, or autologin breaks.
APPEND="boot=live components quiet splash username=live hostname=boykisser noeject"
# The lite image targets ancient GPUs, so it keeps nomodeset everywhere.
[ -e "$ROOT/config/includes.chroot/etc/boykisser/lite" ] && APPEND="$APPEND nomodeset"

# lang | label | locale | kbd
LANGS="
de|Deutsch|de_DE.UTF-8|de
fr|Français|fr_FR.UTF-8|fr
es|Español|es_ES.UTF-8|es
it|Italiano|it_IT.UTF-8|it
pt|Português (Brasil)|pt_BR.UTF-8|br
pl|Polski|pl_PL.UTF-8|pl
nl|Nederlands|nl_NL.UTF-8|nl
"

# --- GRUB (UEFI) ---------------------------------------------------------------
GRUB="$B/boot/grub/grub.cfg"
if [ -f "$GRUB" ]; then
	{
		echo ""
		echo "submenu 'Live system in another language ...' --hotkey=t {"
		echo "        source /boot/grub/theme.cfg"
		printf '%s\n' "$LANGS" | while IFS='|' read -r code label locale kbd; do
			[ -z "$code" ] && continue
			echo "        menuentry \"Live system — $label\" {"
			echo "                linux  $KERNEL $APPEND locales=$locale keyboard-layouts=$kbd findiso=\${iso_path}"
			echo "                initrd $INITRD"
			echo "        }"
		done
		echo "}"
	} >> "$GRUB"
	echo "  grub: language submenu added"
fi

# --- isolinux (BIOS) -------------------------------------------------------------
ISO="$B/isolinux/live.cfg"
if [ -f "$ISO" ]; then
	{
		printf '%s\n' "$LANGS" | while IFS='|' read -r code label locale kbd; do
			[ -z "$code" ] && continue
			echo ""
			echo "label live-$code"
			# isolinux can't draw UTF-8, so spell the names in plain ASCII there
			ascii=$(printf '%s' "$label" | sed 's/ç/c/g; s/ñ/n/g; s/ê/e/g')
			echo "	menu label ^Live ($ascii)"
			echo "	linux $KERNEL"
			echo "	initrd $INITRD"
			echo "	append $APPEND locales=$locale keyboard-layouts=$kbd"
		done
	} >> "$ISO"
	echo "  isolinux: language entries added"
fi
