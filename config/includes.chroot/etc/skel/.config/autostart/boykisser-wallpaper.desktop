[Desktop Entry]
Type=Application
Version=1.0
Name=Boykisser Wallpaper
Comment=Apply the Boykisser wallpaper to every monitor :3
Exec=sh -c 'command -v boykisser-wallpaper >/dev/null 2>&1 && boykisser-wallpaper || true'
OnlyShowIn=XFCE;
X-XFCE-Autostart-Phase=Application
NoDisplay=true
Terminal=false
