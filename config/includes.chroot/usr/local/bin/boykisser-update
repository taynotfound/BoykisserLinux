#!/bin/sh
# boykisser-update :3  —  update everything in one cuddle.
set -e

PINK="\033[38;5;213m"; B="\033[1m"; R="\033[0m"
printf "${PINK}${B}:3 updating Boykisser Linux...${R}\n"

export DEBIAN_FRONTEND=noninteractive

SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

printf "${PINK}-> refreshing apt...${R}\n"
$SUDO apt-get update

# Snapshot before upgrading, so a bad update can be rolled back with
# "sudo timeshift --restore". Skipped in the live session (no persistence)
# and until the user has run timeshift once to configure it.
if command -v timeshift >/dev/null 2>&1 && [ ! -d /run/live ] \
   && [ -f /etc/timeshift/timeshift.json ]; then
	printf "${PINK}-> creating a safety snapshot (timeshift)...${R}\n"
	$SUDO timeshift --create --comments "boykisser-update $(date +%F)" --scripted \
		|| printf "${PINK}   (snapshot failed — continuing without it)${R}\n"
fi

printf "${PINK}-> upgrading packages...${R}\n"
$SUDO apt-get -y full-upgrade

# Pull latest boykisser-tools .deb from GitHub releases if newer than installed.
# ponytail: version-string compare, good enough for v1.2.3 tags
_tools_update() {
	command -v curl >/dev/null 2>&1 || return
	[ -d /run/live ] && return
	latest=$(curl -fsSL "https://api.github.com/repos/taynotfound/boykisser-tools/releases/latest" \
		2>/dev/null | grep -o '"tag_name":"[^"]*"' | cut -d'"' -f4)
	[ -z "$latest" ] && return
	installed=$(dpkg-query -W -f='${Version}' boykisser-tools 2>/dev/null || echo "none")
	[ "$installed" = "${latest#v}" ] && return
	printf "${PINK}-> updating boykisser-tools ${installed} → ${latest}...${R}\n"
	tmp=$(mktemp --suffix=.deb)
	curl -fsSL "https://github.com/taynotfound/boykisser-tools/releases/download/${latest}/boykisser-tools.deb" \
		-o "$tmp" && $SUDO dpkg -i "$tmp" || true
	rm -f "$tmp"
}
_tools_update

if command -v flatpak >/dev/null 2>&1; then
	printf "${PINK}-> updating Flatpaks...${R}\n"
	flatpak update -y || true
fi

if command -v fwupdmgr >/dev/null 2>&1; then
	printf "${PINK}-> checking firmware...${R}\n"
	$SUDO fwupdmgr refresh --force >/dev/null 2>&1 || true
	$SUDO fwupdmgr get-updates 2>/dev/null || true
fi

printf "${PINK}${B}:3 all up to date! mwah${R}\n"
