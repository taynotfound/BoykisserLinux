#!/usr/bin/env python3
# boykisser-center :3  —  the graphical Boykisser control center.
# A proper GTK3 app: system status up top, friendly action tiles below.
# Everything heavy runs through the existing boykisser-* helpers in a terminal.
import os
import shutil
import subprocess

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, GdkPixbuf, Gdk, Pango  # noqa: E402

LOGO = next((p for p in ("/usr/share/boykisser/face.png",
                         "/usr/share/boykisser/start.png",
                         "/usr/share/boykisser/logo.png") if os.path.exists(p)), None)

CSS = b"""
window { background: #fff0f7; }
.hero { background: linear-gradient(135deg, #ff5fa2, #ff8fc0); border-radius: 14px; }
.hero label { color: white; }
.hero .title { font-size: 20px; font-weight: 800; }
.tile {
    background: white; border-radius: 12px; border: 1px solid #ffd3e6;
    padding: 4px; transition: all 150ms ease;
}
.tile:hover { background: #ffe4f0; border-color: #ff5fa2; }
.tile .name { font-weight: 700; color: #71264d; }
.tile .desc { color: #9b5b7c; font-size: 12px; }
.pill {
    background: rgba(255,255,255,0.25); border-radius: 99px;
    padding: 2px 10px; font-size: 12px;
}
"""


def sh(cmd):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True,
                              timeout=5).stdout.strip()
    except Exception:
        return ""


def in_terminal(command, keep_open=True):
    """Run a boykisser helper in the user's terminal emulator."""
    tail = '; echo; read -p "Press enter to close... :3" _' if keep_open else ""
    for term in ("x-terminal-emulator", "xfce4-terminal", "konsole", "gnome-terminal"):
        if shutil.which(term):
            subprocess.Popen([term, "-e", f'sh -c \'{command}{tail}\''])
            return
    subprocess.Popen(["sh", "-c", command])


class Center(Gtk.Window):
    def __init__(self):
        super().__init__(title="Boykisser Center :3")
        self.set_default_size(680, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        if LOGO:
            try:
                self.set_icon_from_file(LOGO)
            except Exception:
                pass

        style = Gtk.CssProvider()
        style.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), style,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                        margin=16)
        self.add(outer)
        outer.pack_start(self._hero(), False, False, 0)

        scroll = Gtk.ScrolledWindow(hexpand=True, vexpand=True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        outer.pack_start(scroll, True, True, 0)

        flow = Gtk.FlowBox(valign=Gtk.Align.START, max_children_per_line=2,
                           min_children_per_line=2, selection_mode=Gtk.SelectionMode.NONE,
                           column_spacing=12, row_spacing=12)
        scroll.add(flow)

        live = os.path.isdir("/run/live")
        tiles = [
            ("system-software-update", "Update everything",
             "apt + Flatpak, with a Timeshift snapshot first",
             lambda: in_terminal("boykisser-update")),
            ("system-software-install", "App presets",
             "Art, Social, Office & Music packs from Flathub",
             lambda: subprocess.Popen(["boykisser-presets"])),
            ("web-browser", "Pick a browser",
             "Firefox, LibreWolf, Brave or Chromium",
             lambda: subprocess.Popen(["boykisser-browser"])),
            ("applications-games", "Get the full app set",
             "OBS, Steam, VS Code, codecs and friends",
             lambda: in_terminal("boykisser-postinstall-apps")),
            ("edit-delete", "Remove apps",
             "Strip the groups you don't want",
             lambda: subprocess.Popen(["boykisser-debloat"])),
            ("preferences-desktop-theme", "Light / dark theme",
             "Flip the whole desktop in one click",
             lambda: subprocess.Popen(["boykisser-theme-toggle"])),
            ("video-display", "NVIDIA drivers",
             "Install the proprietary driver",
             lambda: in_terminal("boykisser-nvidia")),
            ("system-run", "Newer kernel",
             "Latest kernel from trixie-backports",
             lambda: in_terminal("boykisser-kernel --install")),
            ("computer", "System doctor",
             "Quick health check of the important bits",
             lambda: in_terminal("boykisser-doctor")),
            ("edit-clear-all", "Clean up disk space",
             "Old packages, caches and logs",
             lambda: in_terminal("boykisser-cleanup")),
            ("tools-report-bug", "Report a problem",
             "Opens a pre-filled GitHub issue",
             lambda: subprocess.Popen(["boykisser-report"])),
            ("internet-group-chat", "Join the Discord",
             "Say hi or get help :3",
             lambda: subprocess.Popen(["xdg-open", "https://discord.gg/3ZpwE9PPfP"])),
        ]
        if live:
            tiles.insert(0, ("drive-harddisk", "Install to disk",
                             "You're in the live session — make it permanent!",
                             lambda: subprocess.Popen(["install-boykisser"])))
        else:
            tiles.append(("system-lock-screen", "Autologin",
                          "Toggle logging in without a password",
                          self._autologin))

        for icon, name, desc, action in tiles:
            flow.add(self._tile(icon, name, desc, action))

        self.show_all()

    # --- widgets ----------------------------------------------------------------
    def _hero(self):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        box.get_style_context().add_class("hero")
        box.set_property("margin", 0)
        inner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14,
                        margin=14)
        box.pack_start(inner, True, True, 0)

        if LOGO:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(LOGO, 72, 72, True)
                inner.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
            except Exception:
                pass

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                       valign=Gtk.Align.CENTER)
        inner.pack_start(text, True, True, 0)

        title = Gtk.Label(label="Boykisser Center", xalign=0)
        title.get_style_context().add_class("title")
        text.pack_start(title, False, False, 0)

        version = sh("cat /etc/boykisser/version 2>/dev/null") or "Boykisser Linux"
        sub = Gtk.Label(label=version, xalign=0)
        sub.set_ellipsize(Pango.EllipsizeMode.END)
        text.pack_start(sub, False, False, 0)

        pills = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        text.pack_start(pills, False, False, 0)
        self._pills = pills
        GLib.idle_add(self._load_status)
        return box

    def _pill(self, label):
        lbl = Gtk.Label(label=label)
        lbl.get_style_context().add_class("pill")
        self._pills.pack_start(lbl, False, False, 0)
        lbl.show()

    def _load_status(self):
        kernel = sh("uname -r")
        if kernel:
            self._pill(f"🐧 {kernel}")
        if os.path.isdir("/run/live"):
            self._pill("💿 live session")
        disk = sh("df -h --output=avail / | tail -1").strip()
        if disk:
            self._pill(f"💾 {disk} free")
        net = subprocess.run(["getent", "hosts", "deb.debian.org"],
                             capture_output=True).returncode == 0
        self._pill("🌐 online" if net else "🌐 offline")
        return False

    def _tile(self, icon, name, desc, action):
        btn = Gtk.Button()
        btn.get_style_context().add_class("tile")
        btn.set_relief(Gtk.ReliefStyle.NONE)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12,
                      margin=8)
        btn.add(row)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
        row.pack_start(img, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                       valign=Gtk.Align.CENTER)
        row.pack_start(text, True, True, 0)
        n = Gtk.Label(label=name, xalign=0)
        n.get_style_context().add_class("name")
        text.pack_start(n, False, False, 0)
        d = Gtk.Label(label=desc, xalign=0, wrap=True)
        d.get_style_context().add_class("desc")
        text.pack_start(d, False, False, 0)
        btn.connect("clicked", lambda *_: action())
        child = Gtk.FlowBoxChild()
        child.add(btn)
        return child

    def _autologin(self):
        state = sh("boykisser-autologin status")
        on = "ON" in state
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.YES_NO,
                                text=f"Autologin is currently {'on' if on else 'off'}.")
        dlg.format_secondary_text(
            "Turn it OFF again?" if on else
            "Turn it ON? Anyone with the machine gets straight to your desktop!")
        if dlg.run() == Gtk.ResponseType.YES:
            in_terminal(f"boykisser-autologin {'off' if on else 'on'}")
        dlg.destroy()


if __name__ == "__main__":
    win = Center()
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()
