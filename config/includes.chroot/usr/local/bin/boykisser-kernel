#!/bin/sh
# boykisser-kernel :3  —  hop onto the newest kernel from Debian backports.
# Great for brand-new hardware that trixie's stock kernel doesn't know yet.
#
# Usage:
#   boykisser-kernel            show running + available kernels
#   boykisser-kernel --install  install the backports kernel (+ headers)
set -e

PINK="\033[38;5;213m"; B="\033[1m"; R="\033[0m"
say() { printf "${PINK}%s${R}\n" "$1"; }

SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

BPO_LIST=/etc/apt/sources.list.d/backports.sources

ensure_repo() {
	[ -f "$BPO_LIST" ] && return 0
	say "-> enabling the trixie-backports repo..."
	$SUDO tee "$BPO_LIST" >/dev/null <<'EOF'
Types: deb
URIs: https://deb.debian.org/debian
Suites: trixie-backports
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
	$SUDO apt-get update
}

case "${1:-}" in
	--install)
		ensure_repo
		say "-> installing the backports kernel..."
		$SUDO apt-get install -y -t trixie-backports \
			linux-image-amd64 linux-headers-amd64
		say ":3 done! reboot to use the new kernel."
		;;
	""|--status)
		printf "${B}running kernel:${R}   %s\n" "$(uname -r)"
		if [ -f "$BPO_LIST" ]; then CAND="enabled"; else CAND="not enabled"; fi
		printf "${B}backports repo:${R}   %s\n" "$CAND"
		if command -v apt-cache >/dev/null 2>&1 && [ -f "$BPO_LIST" ]; then
			BPO=$(apt-cache -o APT::Default-Release=trixie-backports policy linux-image-amd64 2>/dev/null | awk '/Candidate:/{print $2}')
			printf "${B}backports kernel:${R} %s\n" "${BPO:-unknown}"
		fi
		say ""
		say "install the newest kernel with:  boykisser kernel --install"
		;;
	*)
		echo "usage: boykisser-kernel [--status|--install]" >&2; exit 2 ;;
esac
