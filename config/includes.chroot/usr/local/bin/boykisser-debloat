#!/bin/sh
# boykisser-debloat :3  —  strip the apps you don't want.
# A checklist of removable app groups; picks are purged with apt (and Steam's
# flatpak-free friends removed where relevant). Nothing here touches the
# desktop, drivers or system plumbing — only end-user apps.
# Usage: boykisser-debloat [gaming|obs|vlc|vscode|games ...]

pkgs_for() {
	case "$1" in
		gaming) echo "steam-installer gamemode mangohud" ;;
		obs)    echo "obs-studio" ;;
		vlc)    echo "vlc" ;;
		vscode) echo "code-insiders code" ;;
		games)  echo "gnome-games quadrapassel gnome-mines aisleriot" ;;
		*)      return 1 ;;
	esac
}

label_for() {
	case "$1" in
		gaming) echo "Gaming stack (Steam, GameMode, MangoHud)" ;;
		obs)    echo "OBS Studio" ;;
		vlc)    echo "VLC media player" ;;
		vscode) echo "Visual Studio Code" ;;
		games)  echo "Small desktop games" ;;
	esac
}

# Only offer what is actually installed.
installed_any() {
	for p in $(pkgs_for "$1"); do
		dpkg -s "$p" >/dev/null 2>&1 && return 0
	done
	return 1
}

remove_groups() {
	[ -n "$1" ] || { echo "nothing selected :3"; return 0; }
	pkgs=""
	for g in $1; do
		for p in $(pkgs_for "$g"); do
			dpkg -s "$p" >/dev/null 2>&1 && pkgs="$pkgs $p"
		done
	done
	[ -n "$pkgs" ] || { echo "already gone :3"; return 0; }
	echo ":3 removing:$pkgs"
	# shellcheck disable=SC2086
	sudo apt-get purge -y $pkgs && sudo apt-get autoremove -y --purge
	echo ":3 done! (freed space: run 'boykisser cleanup' for even more)"
}

if [ $# -gt 0 ]; then
	sel=""
	for g in "$@"; do
		pkgs_for "$g" >/dev/null || { echo "unknown group: $g (gaming|obs|vlc|vscode|games)" >&2; exit 1; }
		sel="$sel $g"
	done
	remove_groups "$sel"
	exit $?
fi

ROWS=""
for g in gaming obs vlc vscode games; do
	installed_any "$g" && ROWS="$ROWS $g"
done
[ -n "$ROWS" ] || { echo "nothing removable is installed :3"; exit 0; }

if command -v yad >/dev/null 2>&1 && [ -n "$DISPLAY$WAYLAND_DISPLAY" ]; then
	set --
	for g in $ROWS; do
		set -- "$@" FALSE "$(label_for "$g")" "$g"
	done
	choice=$(yad --list --checklist --title="Remove apps :3" \
		--width=520 --height=300 --center --borders=12 \
		--text="<b>Tick what you want gone</b>\nOnly apps — never system parts." \
		--column="Remove":CHK --column="Group" --column=id --hide-column=3 --no-headers \
		"$@" \
		--button="Remove:0" --button="Cancel:1" 2>/dev/null) || exit 0
	sel=$(printf '%s\n' "$choice" | awk -F'|' '$1=="TRUE"{printf "%s ", $3}')
	[ -n "$sel" ] || exit 0
	x-terminal-emulator -e sh -c "boykisser-debloat $sel; echo; read -p 'Press enter to close...' _" 2>/dev/null \
		|| remove_groups "$sel"
	exit 0
fi

echo "Remove apps :3  — pick any (space-separated):"
for g in $ROWS; do printf "  %-7s %s\n" "$g" "$(label_for "$g")"; done
printf "remove> "
read -r sel
remove_groups "$sel"
