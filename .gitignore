# live-build artifacts
*.iso
*.img
*.log
.build/
cache/
chroot/
chroot.files
chroot.packages.*
binary/
binary.*
live-image-*.files
live-image-*.packages
live-image-*.contents
source/
source.*
.stage/
config/binary
config/bootstrap
config/chroot
config/common
config/source
config/package-lists/*.binary
# live-build's root-level artifact dir only — anchored so it does NOT swallow
# anything under config/includes.chroot/usr/local/.
/local/
*.ovmf-vars.fd
website/
# netinstall build marker (created/removed by build.sh --netinstall)
config/includes.chroot/etc/boykisser/netinstall
config/package-lists/*.disabled
# weekly auto-rebuild state (tools/bk-autobuild.sh)
.autobuild-state
autobuild.log

# local build log (build.sh)
build.log

# test VM disk (test-vm.sh --disk)
vm-disk.img
# tools/build-debs.sh output; build.sh drops the debs into packages.chroot
tools/dist/
config/packages.chroot/
# release tag stamped by build.sh / CI
config/includes.chroot/etc/boykisser/release
config/includes.chroot/etc/boykisser/lite
# website dependencies and build output
web/node_modules/
web/dist/
web/.astro/
__pycache__/
